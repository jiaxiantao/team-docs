# ─── 本地 PostgreSQL（pnpm run dev 使用）────────────────────────────
# 账号密码请与 IDE / pgAdmin 中连接 postgres 18 的配置保持一致
POSTGRES_USER=postgres
POSTGRES_PASSWORD=你的本地密码
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=team_docs

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ─── NextAuth ───────────────────────────────────────────────────────
AUTH_SECRET="change-me-to-a-random-32-char-string"
# 须与浏览器实际访问端口一致（Next 若落在 3001 则改为 3001）
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# ─── GitHub OAuth（可选，配置后登录页显示 GitHub 按钮）────────────
# GITHUB_ID=""
# GITHUB_SECRET=""

# ─── 协同编辑（须与 collab-server 一致）────────────────────────────
COLLAB_SECRET="change-me-collab-secret-shared-with-server"
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"

# ─── Collab server ──────────────────────────────────────────────────
COLLAB_PORT=1234
# 多实例水平扩展时配置（Docker Compose 已默认 redis://redis:6379）
# REDIS_URL=redis://localhost:6379
# COLLAB_SERVER_NAME=collab-1

# ─── 图片附件存储 ───────────────────────────────────────────────────
# 本地开发默认写入 ./uploads；生产可切换 S3 兼容存储
# UPLOAD_DIR=./uploads
# STORAGE_DRIVER=s3
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=1

NODE_ENV=development

# CI / Docker 构建时可跳过启动时环境变量校验
# SKIP_ENV_VALIDATION=1

# ─── Docker Compose 专用（本地 dev 勿改上面 DATABASE_URL）──────────
# docker compose 使用独立库名 teamdocs，见 docker-compose.yml
